# Sunucu
PORT=3000
# Virgülle ayrılmış davet kodları (arkadaş grubuna verilecek)
INVITE_CODES=degistir-2026

# Hangi servis kullanılacak: pruna | wan | mock (mock = API çağırmadan uçtan uca test)
PROVIDER=pruna

# Pruna P-Video-Replace
PRUNA_API_KEY=
PRUNA_RESOLUTION=720p

# Wan 2.2 Animate – Replace (Replicate üzerinden)
REPLICATE_API_TOKEN=
WAN_MODEL=wan-video/wan-2.2-animate-replace
# Replicate model şemasındaki alan adları (API sekmesinden doğrulayın)
WAN_VIDEO_FIELD=video
WAN_IMAGE_FIELD=character_image

# Aynı anda işlenecek iş sayısı ve dosyaların saklanma süresi
MAX_CONCURRENT_JOBS=1
RETENTION_HOURS=24

# İsteğe bağlı: Supabase (doluysa sonuç videoları Supabase Storage'a yüklenir)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=results
